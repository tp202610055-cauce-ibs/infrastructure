# Variables de la VM. No se copia a mano: ./generate-env.sh crea vm/.env con secretos aleatorios.
# Aquí solo hay nombres y marcadores.

# --- Dominio y certificados ---
DOMAIN=CAMBIA_ESTO
ACME_EMAIL=CAMBIA_ESTO
# Vacío: Let's Encrypt de producción. Para probar: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=

# --- Imágenes de la API y del portal (las fija update.sh con las referencias de backend y web-portal) ---
API_IMAGE_TAG=local
PORTAL_WEB_TAG=local

# --- PostgreSQL ---
POSTGRES_DB=cauce
POSTGRES_USER=cauce
POSTGRES_PASSWORD=CAMBIA_ESTO
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CAMBIA_ESTO

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIA_ESTO
KEYCLOAK_BACKEND_CLIENT_SECRET=CAMBIA_ESTO
KEYCLOAK_PORTAL_CLIENT_SECRET=CAMBIA_ESTO

# --- KeyDB ---
KEYDB_PASSWORD=CAMBIA_ESTO

# --- MinIO (root solo para administrar; la API usa su propio usuario) ---
MINIO_ROOT_USER=CAMBIA_ESTO
MINIO_ROOT_PASSWORD=CAMBIA_ESTO
MINIO_API_ACCESS_KEY=CAMBIA_ESTO
MINIO_API_SECRET_KEY=CAMBIA_ESTO

# --- API ---
ADMIN_API_KEY=CAMBIA_ESTO
FCM_USE_FAKE=true
RECOMMENDATIONS_EXPIRATION_WINDOW_HOURS=72
WORKERS_OUTBOX_DISPATCHER_ENABLED=true
WORKERS_NOTIFICATION_DISPATCHER_ENABLED=true
WORKERS_RECOMMENDATION_EXPIRATION_ENABLED=true
WORKERS_RECOMMENDATION_ARCHIVAL_ENABLED=true
WORKERS_OUTBOX_RETENTION_ENABLED=true
WORKERS_WEEKLY_REMINDER_ENABLED=true
WORKERS_IBS_SSS_REMINDER_ENABLED=true
# false en la semana de QA: los revisores pueden compartir una IP y recibirían 429.
RATE_LIMITING_ENABLED=true

# --- Buzón de prueba (/mail) ---
MAIL_USER=revisor
# Hash bcrypt entre comillas simples, para que Docker Compose no interprete los signos $.
MAIL_PASSWORD_HASH='CAMBIA_ESTO'
