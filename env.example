# =============================================================================
# Cauce — Variables de entorno (DEVELOPMENT)
# =============================================================================
# 1. Copia este archivo a `.env` (sin el sufijo .example)
# 2. Cambia todos los valores marcados con CAMBIA_ESTO
# 3. NUNCA commitees el archivo .env real (ya está en .gitignore)
# ==============================================docker compose --profile auth up -d===============================

# --- PostgreSQL principal: BD de la app Cauce ---
POSTGRES_DB=cauce_dev
POSTGRES_USER=cauce
POSTGRES_PASSWORD=CAMBIA_ESTO_a_password_seguro_dev

# --- PostgreSQL secundario: BD de Keycloak (mismo contenedor, BD separada) ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CAMBIA_ESTO_a_password_seguro_dev

# --- Keycloak: credenciales del admin maestro ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIA_ESTO_a_password_seguro_dev

# --- KeyDB ---
KEYDB_PASSWORD=CAMBIA_ESTO_a_password_seguro_dev

# --- MinIO (MINIO_ROOT_PASSWORD debe tener mínimo 8 caracteres) ---
MINIO_ROOT_USER=cauce_minio_admin
MINIO_ROOT_PASSWORD=CAMBIA_ESTO_min8caracteres

# --- Puertos expuestos en el host (cambia solo si tienes conflicto) ---
POSTGRES_PORT=5432
ADMINER_PORT=8080
KEYCLOAK_PORT=8081
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
KEYDB_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OLLAMA_PORT=11434
