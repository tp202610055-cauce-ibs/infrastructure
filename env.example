# --- PostgreSQL principal: BD de la app Cauce ---
POSTGRES_DB=cauce_dev
POSTGRES_USER=cauce
POSTGRES_PASSWORD=cauce_pg_dev_2026

# --- PostgreSQL secundario: BD de Keycloak (mismo contenedor, BD separada) ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=cauce_kc_db_dev_2026

# --- Keycloak: credenciales del admin maestro ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cauce_kc_admin_dev_2026

# --- KeyDB ---
KEYDB_PASSWORD=cauce_keydb_dev_2026

# --- MinIO (MINIO_ROOT_PASSWORD debe tener mínimo 8 caracteres) ---
MINIO_ROOT_USER=cauce_minio_admin
MINIO_ROOT_PASSWORD=cauce_minio_dev_2026

# --- Puertos expuestos en el host (cambia solo si tienes conflicto) ---
POSTGRES_PORT=5432
ADMINER_PORT=8080
KEYCLOAK_PORT=8081
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
KEYDB_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OLLAMA_PORT=11434
